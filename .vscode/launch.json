{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Client",
      "type": "coreclr",
      "request": "launch",
      "program": "${env:VINTAGE_STORY}/Vintagestory.exe",
      "linux": {
        "program": "${env:VINTAGE_STORY}/Vintagestory"
      },
      "osx": {
        "program": "${env:VINTAGE_STORY}/Vintagestory"
      },
      "preLaunchTask": "build",
      "args": [
        "--addModPath",
        "${workspaceFolder}/AutoClay/bin/Debug/Mods"
      ],
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
